{
  "name": "@devtools/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=26.0.0 <27",
    "pnpm": ">=11.18.0 <12"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --build --force && vite build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "lint:styles": "stylelint \"src/**/*.{vue,scss}\" --max-warnings 0",
    "typecheck": "vue-tsc --build --force",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "verify:build": "tsx scripts/verify-build.ts",
    "check:deps": "pnpm peers check",
    "check": "pnpm check:deps && pnpm format:check && pnpm lint && pnpm lint:styles && pnpm typecheck && pnpm test:coverage && pnpm build && pnpm verify:build"
  },
  "dependencies": {
    "@bwip-js/browser": "4.11.4",
    "fast-xml-builder": "1.3.1",
    "fast-xml-parser": "5.11.1",
    "fast-xml-validator": "1.4.2",
    "json5": "2.2.3",
    "naive-ui": "2.45.3",
    "pako": "3.0.1",
    "papaparse": "5.7.0",
    "qs": "6.16.0",
    "smol-toml": "1.8.0",
    "tui-image-editor": "3.15.3",
    "vue": "3.5.42",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.4.0",
    "@types/papaparse": "5.5.2",
    "@types/qs": "6.15.1",
    "@vitejs/plugin-vue": "6.0.8",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "10.9.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "10.10.0",
    "globals": "17.11.0",
    "lightningcss": "1.33.0",
    "postcss-html": "2.0.0",
    "prettier": "3.9.6",
    "sass": "1.103.1",
    "stylelint": "17.14.1",
    "stylelint-config-html": "2.0.0",
    "stylelint-config-recommended-vue": "2.0.0",
    "stylelint-config-standard-scss": "17.0.0",
    "stylelint-order": "8.1.1",
    "tsx": "4.23.13",
    "typescript": "6.0.2",
    "typescript-eslint": "8.68.0",
    "vite": "8.2.2",
    "vite-plugin-singlefile": "2.3.3",
    "vitest": "4.1.11",
    "vue-eslint-parser": "10.4.1",
    "vue-tsc": "3.3.11"
  }
}
