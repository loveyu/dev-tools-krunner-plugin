[Desktop Entry]
Type=Service
Name=DevTools
Name[zh_CN]=开发工具
Comment=Developer utilities: date, timestamps, RFC3339, ISO8601 and more.
Comment[zh_CN]=开发工具：日期、时间戳、RFC3339、ISO8601 等。
Icon=utilities-terminal
X-KDE-PluginInfo-Author=hu_zhi_yu
X-KDE-PluginInfo-Name=org.kde.devtools
X-KDE-PluginInfo-Version=0.1.0
X-KDE-PluginInfo-License=MIT
X-KDE-PluginInfo-EnabledByDefault=true
# Plasma 6 DBus runner (DBus2) protocol:
X-Plasma-API=DBus2
X-Plasma-DBusRunner-Service=org.kde.devtools
X-Plasma-DBusRunner-Path=/runner
# Only invoke us for 2+ characters (we still filter by keyword ourselves).
X-Plasma-Runner-Min-Letter-Count=2
